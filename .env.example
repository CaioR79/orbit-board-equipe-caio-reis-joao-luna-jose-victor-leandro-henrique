# Porta pública do backend (host). O container escuta internamente na 8080.
BACKEND_PORT=5200

# Porta pública do frontend (host). O Nginx escuta internamente na 80.
FRONTEND_PORT=5173

# URL da API que o NAVEGADOR usa para chamar o backend.
# Passada como build arg ao frontend (o Vite resolve em build time).
VITE_API_URL=http://localhost:5200

# Origem(ns) que o backend libera no CORS (separar por vírgula se mais de uma).
CORS_ALLOWED_ORIGINS=http://localhost:5173